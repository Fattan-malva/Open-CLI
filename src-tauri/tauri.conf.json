{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open CLI",
  "version": "0.1.0",
  "identifier": "com.opencli.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "appDirectoriesOverride": "$HOME/.config/opencli",
    "windows": [
      {
        "label": "main",
        "title": "Open CLI",
        "width": 1440,
        "height": 900,
        "minWidth": 860,
        "minHeight": 600,
        "decorations": false,
        "devtools": false,
        "theme": "Dark",
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
